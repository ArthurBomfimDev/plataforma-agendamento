# Normaliza fim de linha no repositório: LF sempre.
# Arthur e Rafael estão em Windows; sem isso o diff enche de ^M.
* text=auto eol=lf

# ---------- Sempre LF, mesmo no Windows ----------
*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.sln       text eol=crlf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf

# ---------- Scripts do Windows precisam de CRLF ----------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------- Binários — nunca normalizar ----------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.zip       binary

# ---------- Não contam como código nas estatísticas ----------
docs/**        linguist-documentation
*.md           linguist-documentation
.agents/**     linguist-vendored
