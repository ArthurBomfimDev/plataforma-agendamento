# Copie para .env.local para rodar com `bun run dev` fora do Docker.
# Sem VITE_API_BASE_URL, o app chama /api na própria origem e o dev server do Vite repassa para a API abaixo.
# Padrão: a API do `dotnet run` (launchSettings, http://localhost:5167). Pelo Docker: http://localhost:8081.
DEV_API_PROXY=http://localhost:5167

# Só para API em outro endereço (Capacitor, Tauri): a URL absoluta entra no build.
# VITE_API_BASE_URL=http://localhost:8081
