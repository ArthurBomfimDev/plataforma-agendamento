<Project>
  <!--
    Vale para todos os projetos de backend/. Um .csproj só declara o que for diferente disto.

    TreatWarningsAsErrors + EnforceCodeStyleInBuild: as regras do .editorconfig marcadas como
    warning (namespace com escopo de arquivo, chaves obrigatórias, _campoPrivado) quebram o build,
    não só o `dotnet format`. Aviso que não quebra nada é aviso que ninguém lê.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
