# Copie para .env (ou rode scripts/setup-env) e troque os valores.
# O .env NÃO é versionado. Nunca commite senha ou chave real.

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=troque-esta-senha

# Chave HS256 do JWT. Mínimo de 32 caracteres.
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# Portas no host
WEB_PORT=8080
API_PORT=8081
DB_PORT=5433
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Marca nos textos dos e-mails (pode mudar sem mudar código).
APP_BRAND_NAME=Vagoo

# E-mail de verdade (ADR-021). Vazio, o compose manda tudo para o Mailpit local e nada sai da máquina.
# Para enviar pelo Gmail (demonstração pública, docs/operacao/demo-publica.md), tire o # e preencha:
#   - Username é a própria conta Gmail, e From é IGUAL a ele: o Gmail exige que o remetente seja a conta
#     autenticada (outro From é reescrito ou recusado).
#   - Password é a SENHA DE APP de 16 letras, sem espaços (Conta Google > Segurança > Senhas de app), nunca a
#     senha normal da conta. Ela fica só neste .env, que não é versionado.
#   - 587 com UseSsl=true: STARTTLS obrigatório.
# Email__Smtp__Host=smtp.gmail.com
# Email__Smtp__Port=587
# Email__Smtp__UseSsl=true
#   - CheckCertificateRevocation (padrão true): a API consulta a CRL do certificado do servidor. Se o seu ambiente não
#     alcança a CRL do Gmail (c.pki.goog) e o envio falha com "unable to get certificate CRL", ponha false: a cadeia e
#     o nome do servidor continuam validados, só a consulta de revogação é dispensada. Menos uma garantia; ver
#     docs/operacao/demo-publica.md. O compose repassa a variável para a API.
# Email__Smtp__CheckCertificateRevocation=true
# Email__Smtp__Username=conta@gmail.com
# Email__Smtp__Password=
# Email__From=conta@gmail.com
# Email__FromName=Vagoo

# Base dos links dos e-mails. O scripts/demo-publica preenche sozinho com o endereço do túnel.
# APP_PUBLIC_BASE_URL=http://localhost:8080

# Ambiente da API no compose. Development no uso local; a demonstração pública sobe em Production.
# ASPNETCORE_ENVIRONMENT=Development

# Túnel nomeado da Cloudflare (opcional; endereço fixo num domínio seu). O modo rápido não precisa disto.
# TUNNEL_TOKEN=

# Senhas das contas do seed de demonstração (scripts/seed-demo.ts). Fora de Development o seed recusa a senha
# padrão. SEED_ADMIN_PASSWORD vazio: o seed gera uma senha aleatória para admin@example.com e mostra uma vez.
# SEED_PASSWORD=
# SEED_ADMIN_PASSWORD=

# Login exige e-mail confirmado (Onda 6A). Padrão true; false só para depurar, nunca em produção.
# Identity__RequireEmailConfirmation=true

# Localização (Onda 6B, ADR-022). Os padrões usam os serviços públicos, sem chave; trocar de provedor é trocar estes.
# Geo__UserAgent=Vagoo/0.1 (projeto academico FATEC Garca)
# Geo__Nominatim__BaseUrl=https://nominatim.openstreetmap.org/
# Geo__Nominatim__MinIntervalMilliseconds=1000
# Geo__Nominatim__Email=contato@seu-dominio.com
# Geo__PostalCode__Provider=BrasilApi
# Geo__PostalCode__BaseUrl=
# Geo__TimeoutSeconds=5
# Geo__CacheHours=24

# Imagens (Onda 6D, ADR-023). No compose, /app/media-data é o volume media-data. Fora do Docker, uma pasta local.
# Storage__Root=/app/media-data
