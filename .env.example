# Copie para .env (ou rode scripts/setup-env) e troque os valores.
# O .env NÃO é versionado. Nunca commite senha ou chave real.

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=troque-esta-senha

# Chave HS256 do JWT. Mínimo de 32 caracteres.
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# Portas no host
WEB_PORT=8080
API_PORT=8081
DB_PORT=5433
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Marca nos textos dos e-mails (pode mudar sem mudar código).
APP_BRAND_NAME=Vagoo

# E-mail em produção (ADR-021). No ambiente local o compose usa o Mailpit e ignora estes nomes.
# Valores de exemplo; a credencial real vai só no .env do servidor, nunca no repositório.
# Email__Smtp__Host=smtp.exemplo-de-provedor.com
# Email__Smtp__Port=587
# Email__Smtp__User=usuario-do-provedor
# Email__Smtp__Password=troque-pela-senha-do-provedor
# Email__Smtp__UseSsl=true
# Email__From=nao-responda@seu-dominio.com
# Email__FromName=Vagoo
# App__PublicBaseUrl=https://seu-dominio.com
