# Copie para .env (ou rode scripts/setup-env) e troque os valores.
# O .env NÃO é versionado. Nunca commite senha ou chave real.

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=troque-esta-senha

# Chave HS256 do JWT. Mínimo de 32 caracteres.
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# Portas no host
WEB_PORT=8080
API_PORT=8081
DB_PORT=5433
